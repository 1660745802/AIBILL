      "package_name": "com.tencent.mm",
      "direct_pass_titles": [
        "微信支付",
        "微信支付凭证"
      ],
      "direct_pass_title_contains": [
        "零钱"
      ],
      "message_prefixes": [
        "[转账]",
        "[微信红包]"
      ],
      "amount_symbols": [
        "¥",
        "￥"
      ]
    },
    "alipay": {
      "package_name": "com.eg.android.AlipayGphone",
